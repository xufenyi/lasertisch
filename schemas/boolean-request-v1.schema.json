{
  "$defs": {
    "BooleanOperation": {
      "enum": [
        "union",
        "intersection",
        "difference"
      ],
      "title": "BooleanOperation",
      "type": "string"
    },
    "ContourDirection": {
      "enum": [
        "clockwise",
        "counterclockwise"
      ],
      "title": "ContourDirection",
      "type": "string"
    },
    "EllipseEntity": {
      "additionalProperties": false,
      "description": "A parameterized straight-edge approximation of an inscribed ellipse.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "process": {
          "$ref": "#/$defs/ProcessSpec"
        },
        "kind": {
          "const": "ellipse",
          "default": "ellipse",
          "title": "Kind",
          "type": "string"
        },
        "center": {
          "$ref": "#/$defs/PointUm"
        },
        "widthUm": {
          "exclusiveMinimum": 0,
          "maximum": 190000,
          "title": "Widthum",
          "type": "integer"
        },
        "heightUm": {
          "exclusiveMinimum": 0,
          "maximum": 190000,
          "title": "Heightum",
          "type": "integer"
        },
        "rotationTenthsDeg": {
          "default": 0,
          "exclusiveMaximum": 3600,
          "minimum": 0,
          "title": "Rotationtenthsdeg",
          "type": "integer"
        },
        "sides": {
          "default": 64,
          "maximum": 1024,
          "minimum": 3,
          "title": "Sides",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "center",
        "widthUm",
        "heightUm"
      ],
      "title": "EllipseEntity",
      "type": "object"
    },
    "FontReference": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[0-9a-f]{64}:[0-9]+$",
          "title": "Id",
          "type": "string"
        },
        "fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "faceIndex": {
          "minimum": 0,
          "title": "Faceindex",
          "type": "integer"
        },
        "family": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "style": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Style",
          "type": "string"
        },
        "fullName": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Fullname",
          "type": "string"
        },
        "postscriptName": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Postscriptname",
          "type": "string"
        },
        "unitsPerEm": {
          "exclusiveMinimum": 0,
          "maximum": 65536,
          "title": "Unitsperem",
          "type": "integer"
        },
        "bundled": {
          "title": "Bundled",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "fingerprint",
        "faceIndex",
        "family",
        "style",
        "fullName",
        "postscriptName",
        "unitsPerEm",
        "bundled"
      ],
      "title": "FontReference",
      "type": "object"
    },
    "GlobalSettings": {
      "additionalProperties": false,
      "properties": {
        "travelSpeedUmPerSec": {
          "default": 10000000,
          "exclusiveMinimum": 0,
          "title": "Travelspeedumpersec",
          "type": "integer"
        },
        "minimumMarkSegmentUm": {
          "const": 100,
          "default": 100,
          "title": "Minimummarksegmentum",
          "type": "integer"
        },
        "initialJumpToOrigin": {
          "const": true,
          "default": true,
          "title": "Initialjumptoorigin",
          "type": "boolean"
        }
      },
      "title": "GlobalSettings",
      "type": "object"
    },
    "GridSettings": {
      "additionalProperties": false,
      "properties": {
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "spacingUm": {
          "default": 5000,
          "exclusiveMinimum": 0,
          "maximum": 190000,
          "title": "Spacingum",
          "type": "integer"
        },
        "snapMove": {
          "default": true,
          "title": "Snapmove",
          "type": "boolean"
        },
        "snapResize": {
          "default": true,
          "title": "Snapresize",
          "type": "boolean"
        }
      },
      "title": "GridSettings",
      "type": "object"
    },
    "LineEntity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "process": {
          "$ref": "#/$defs/ProcessSpec"
        },
        "kind": {
          "const": "line",
          "default": "line",
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "$ref": "#/$defs/PointUm"
        },
        "end": {
          "$ref": "#/$defs/PointUm"
        }
      },
      "required": [
        "id",
        "name",
        "start",
        "end"
      ],
      "title": "LineEntity",
      "type": "object"
    },
    "PointUm": {
      "additionalProperties": false,
      "properties": {
        "xUm": {
          "title": "Xum",
          "type": "integer"
        },
        "yUm": {
          "title": "Yum",
          "type": "integer"
        }
      },
      "required": [
        "xUm",
        "yUm"
      ],
      "title": "PointUm",
      "type": "object"
    },
    "PolygonEntity": {
      "additionalProperties": false,
      "description": "Local straight-edge rings and their rigid placement in world coordinates.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "process": {
          "$ref": "#/$defs/ProcessSpec"
        },
        "kind": {
          "const": "polygon",
          "default": "polygon",
          "title": "Kind",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/PointUm"
        },
        "rotationTenthsDeg": {
          "default": 0,
          "exclusiveMaximum": 3600,
          "minimum": 0,
          "title": "Rotationtenthsdeg",
          "type": "integer"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/PolygonPart"
          },
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "parts"
      ],
      "title": "PolygonEntity",
      "type": "object"
    },
    "PolygonPart": {
      "additionalProperties": false,
      "properties": {
        "outerRing": {
          "items": {
            "$ref": "#/$defs/PointUm"
          },
          "minItems": 3,
          "title": "Outerring",
          "type": "array"
        },
        "holes": {
          "items": {
            "items": {
              "$ref": "#/$defs/PointUm"
            },
            "minItems": 3,
            "type": "array"
          },
          "title": "Holes",
          "type": "array"
        }
      },
      "required": [
        "outerRing"
      ],
      "title": "PolygonPart",
      "type": "object"
    },
    "ProcessMode": {
      "enum": [
        "none",
        "contour",
        "fill",
        "fill_then_contour",
        "contour_then_fill"
      ],
      "title": "ProcessMode",
      "type": "string"
    },
    "ProcessSpec": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "$ref": "#/$defs/ProcessMode",
          "default": "contour"
        },
        "markSpeedUmPerSec": {
          "default": 900000,
          "exclusiveMinimum": 0,
          "title": "Markspeedumpersec",
          "type": "integer"
        },
        "fillAngleTenthsDeg": {
          "default": 0,
          "exclusiveMaximum": 3600,
          "minimum": 0,
          "title": "Fillangletenthsdeg",
          "type": "integer"
        },
        "hatchSpacingUm": {
          "default": 80,
          "exclusiveMinimum": 0,
          "title": "Hatchspacingum",
          "type": "integer"
        },
        "contourDirection": {
          "$ref": "#/$defs/ContourDirection",
          "default": "clockwise"
        }
      },
      "title": "ProcessSpec",
      "type": "object"
    },
    "ProjectDocument": {
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 2,
          "default": 2,
          "title": "Schemaversion",
          "type": "integer"
        },
        "documentId": {
          "format": "uuid",
          "title": "Documentid",
          "type": "string"
        },
        "projectName": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Projectname",
          "type": "string"
        },
        "units": {
          "const": "um",
          "default": "um",
          "title": "Units",
          "type": "string"
        },
        "workArea": {
          "$ref": "#/$defs/WorkArea"
        },
        "grid": {
          "$ref": "#/$defs/GridSettings"
        },
        "defaultProcess": {
          "$ref": "#/$defs/ProcessSpec"
        },
        "globalSettings": {
          "$ref": "#/$defs/GlobalSettings"
        },
        "entities": {
          "items": {
            "discriminator": {
              "mapping": {
                "ellipse": "#/$defs/EllipseEntity",
                "line": "#/$defs/LineEntity",
                "polygon": "#/$defs/PolygonEntity",
                "rectangle": "#/$defs/RectangleEntity",
                "text": "#/$defs/TextEntity"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RectangleEntity"
              },
              {
                "$ref": "#/$defs/LineEntity"
              },
              {
                "$ref": "#/$defs/PolygonEntity"
              },
              {
                "$ref": "#/$defs/EllipseEntity"
              },
              {
                "$ref": "#/$defs/TextEntity"
              }
            ]
          },
          "title": "Entities",
          "type": "array"
        },
        "processingOrder": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Processingorder",
          "type": "array"
        }
      },
      "required": [
        "documentId",
        "projectName"
      ],
      "title": "ProjectDocument",
      "type": "object"
    },
    "RectangleEntity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "process": {
          "$ref": "#/$defs/ProcessSpec"
        },
        "kind": {
          "const": "rectangle",
          "default": "rectangle",
          "title": "Kind",
          "type": "string"
        },
        "center": {
          "$ref": "#/$defs/PointUm"
        },
        "widthUm": {
          "exclusiveMinimum": 0,
          "maximum": 190000,
          "title": "Widthum",
          "type": "integer"
        },
        "heightUm": {
          "exclusiveMinimum": 0,
          "maximum": 190000,
          "title": "Heightum",
          "type": "integer"
        },
        "rotationTenthsDeg": {
          "default": 0,
          "exclusiveMaximum": 3600,
          "minimum": 0,
          "title": "Rotationtenthsdeg",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "center",
        "widthUm",
        "heightUm"
      ],
      "title": "RectangleEntity",
      "type": "object"
    },
    "TextEntity": {
      "additionalProperties": false,
      "description": "Editable source plus authoritative baked local rings; never load a font on import.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "locked": {
          "default": false,
          "title": "Locked",
          "type": "boolean"
        },
        "process": {
          "$ref": "#/$defs/ProcessSpec"
        },
        "kind": {
          "const": "text",
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/PointUm"
        },
        "rotationTenthsDeg": {
          "default": 0,
          "exclusiveMaximum": 3600,
          "minimum": 0,
          "title": "Rotationtenthsdeg",
          "type": "integer"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/PolygonPart"
          },
          "minItems": 1,
          "title": "Parts",
          "type": "array"
        },
        "text": {
          "$ref": "#/$defs/TextSource"
        },
        "generatorVersion": {
          "const": "font-outline-v1",
          "default": "font-outline-v1",
          "title": "Generatorversion",
          "type": "string"
        },
        "engineVersions": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "title": "Engineversions",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "parts",
        "text",
        "engineVersions"
      ],
      "title": "TextEntity",
      "type": "object"
    },
    "TextSource": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "font": {
          "$ref": "#/$defs/FontReference"
        },
        "fontSizeUm": {
          "exclusiveMinimum": 0,
          "maximum": 190000,
          "title": "Fontsizeum",
          "type": "integer"
        },
        "curveToleranceUm": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Curvetoleranceum",
          "type": "integer"
        },
        "shortSegmentTargetUm": {
          "default": 0,
          "maximum": 190000,
          "minimum": 0,
          "title": "Shortsegmenttargetum",
          "type": "integer"
        },
        "layout": {
          "const": "single_line",
          "default": "single_line",
          "title": "Layout",
          "type": "string"
        }
      },
      "required": [
        "content",
        "font",
        "fontSizeUm",
        "curveToleranceUm"
      ],
      "title": "TextSource",
      "type": "object"
    },
    "WorkArea": {
      "additionalProperties": false,
      "properties": {
        "widthUm": {
          "default": 190000,
          "exclusiveMinimum": 0,
          "maximum": 190000,
          "title": "Widthum",
          "type": "integer"
        },
        "heightUm": {
          "default": 190000,
          "exclusiveMinimum": 0,
          "maximum": 190000,
          "title": "Heightum",
          "type": "integer"
        },
        "center": {
          "$ref": "#/$defs/PointUm"
        },
        "origin": {
          "const": "center",
          "default": "center",
          "title": "Origin",
          "type": "string"
        }
      },
      "title": "WorkArea",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": 1,
      "default": 1,
      "title": "Apiversion",
      "type": "integer"
    },
    "requestId": {
      "format": "uuid",
      "title": "Requestid",
      "type": "string"
    },
    "documentRevision": {
      "minimum": 0,
      "title": "Documentrevision",
      "type": "integer"
    },
    "document": {
      "$ref": "#/$defs/ProjectDocument"
    },
    "operation": {
      "$ref": "#/$defs/BooleanOperation"
    },
    "operandAId": {
      "format": "uuid",
      "title": "Operandaid",
      "type": "string"
    },
    "operandBId": {
      "format": "uuid",
      "title": "Operandbid",
      "type": "string"
    }
  },
  "required": [
    "requestId",
    "documentRevision",
    "document",
    "operation",
    "operandAId",
    "operandBId"
  ],
  "title": "BooleanRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lasertisch.local/schemas/boolean-request-v1.schema.json"
}
